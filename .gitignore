# Cache de import do Godot: e reconstruido sozinho e muda a cada abertura.
.godot/

# Ferramentas locais, nao codigo do jogo: o Godot.app tem 200 MB e o node_modules
# do proxy nao e usado (esta maquina nao tem Node).
.tools/Godot.app/
.tools/mcp-proxy/node_modules/
downloads/

.DS_Store

# Malha bruta do personagem e o pacote do Mixamo: 25 MB que se regeram do GLB
# original por .tools/preparar_mixamo.py.
personagem/heroi_mixamo/
personagem/heroi_mixamo.zip

# Os FBX do Mixamo trazem a malha inteira (16 MB cada, 110 MB no total). O jogo
# usa a biblioteca assada (personagem/heroi_anims.res) e UMA malha; os originais
# ficam fora do repositorio.
personagem/animacoes/

# FBX temporarios da Wins: oito arquivos de 30 MB usados apenas para assar
# personagem/wins_anims.res. Os originais continuam na pasta-fonte externa.
personagem/wins_animacoes/
personagem/wins_modelo/

# Arte reprovada esperando ser regerada no Flow: os tres sprites vieram com o
# contorno branco de adesivo pintado POR DENTRO do desenho, entre as folhas, e
# recorte nenhum tira sem esburacar a moita.
textures/props/_refazer/

# O Godot varre builds/web e importa os icones da pagina como se fossem arte do
# jogo. Sao gerados na exportacao e nao entram no .pck.
builds/web/*.import

# Pacotes-fonte baixados; o jogo versiona somente as peças selecionadas em
# assets/dungeon, evitando carregar dezenas de modelos que não usa.
kenney_modular-dungeon-kit_1.0.zip
Updated Modular Dungeon*.zip
*_4k.blend.zip
